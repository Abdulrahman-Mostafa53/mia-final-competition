<?xml version="1.0"?>
<sdf version="1.6">
  <model name="map">
    <!-- Set to false so physics and gravity apply -->
    <static>true</static>
    
    <link name="link">
      
      <!-- Physical Mass & Inertia Properties -->
      <inertial>
        <mass>5000000000.0</mass> <!-- Mass in kg -->
        <inertia>
          <ixx>1.0</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>1.0</iyy><iyz>0.0</iyz>
          <izz>1.0</izz>
        </inertia>
      </inertial>

      <!-- Physical Collision Boundary -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://map/meshes/map.glb</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- Visual Appearance -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://map/meshes/map.glb</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
